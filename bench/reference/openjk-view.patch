diff --git a/codemp/cgame/cg_light.c b/codemp/cgame/cg_light.c
index 976ae03..fd4daed 100644
--- a/codemp/cgame/cg_light.c
+++ b/codemp/cgame/cg_light.c
@@ -57,7 +57,8 @@ void CG_RunLightStyles (void)
 	int ofs, i;
 	clightstyle_t *ls;
 
-	ofs = cg.time / 50;
+	// swjkja reference capture: a pinned time (ms) for light styles.
+	ofs = ( cg_swjkjaTime.string[0] ? cg_swjkjaTime.integer : cg.time ) / 50;
 //	if ( ofs == lastofs )
 //		return;
 	lastofs = ofs;
diff --git a/codemp/cgame/cg_view.c b/codemp/cgame/cg_view.c
index 0229760..936d639 100644
--- a/codemp/cgame/cg_view.c
+++ b/codemp/cgame/cg_view.c
@@ -2612,6 +2612,15 @@ void CG_DrawActiveFrame( int serverTime, stereoFrame_t stereoView, qboolean demo
 
 	// build cg.refdef
 	inwater = CG_CalcViewValues();
+	// swjkja reference capture: force an exact view, "x y z pitch yaw roll".
+	if ( cg_swjkjaView.string[0] ) {
+		vec3_t o, a;
+		if ( sscanf( cg_swjkjaView.string, "%f %f %f %f %f %f", &o[0], &o[1], &o[2], &a[0], &a[1], &a[2] ) == 6 ) {
+			VectorCopy( o, cg.refdef.vieworg );
+			VectorCopy( a, cg.refdef.viewangles );
+			AnglesToAxis( cg.refdef.viewangles, cg.refdef.viewaxis );
+		}
+	}
 	CG_SetupFrustum();
 
 	if (cg_linearFogOverride)
@@ -2669,6 +2678,10 @@ void CG_DrawActiveFrame( int serverTime, stereoFrame_t stereoView, qboolean demo
 	}
 
 	cg.refdef.time = cg.time;
+	// swjkja reference capture: a pinned time (ms) for shader animation.
+	if ( cg_swjkjaTime.string[0] ) {
+		cg.refdef.time = cg_swjkjaTime.integer;
+	}
 	memcpy( cg.refdef.areamask, cg.snap->areamask, sizeof( cg.refdef.areamask ) );
 
 	// warning sounds when powerup is wearing off
