+// swjkja reference capture: prints each NPC's legs and torso animation as ghoul2
+// holds it (bones model_root and lower_lumbar), once per pinned time, so the new
+// renderer's animation timing can be checked against the original's. Times are
+// relative to the first frame drawn on the map (as the pinned ghoul2 time is).
+static int swjkjaFirst = -1;
+static void CG_SwjkjaLogNPCs( void ) {
+	static int logged = -1;
+	const int first = swjkjaFirst;
+	if ( !cg_swjkjaTime.string[0] || logged == cg_swjkjaTime.integer ) {
+		return;
+	}
+	logged = cg_swjkjaTime.integer;
+	for ( int i = 0; i < ENTITYNUM_WORLD; i++ ) {
+		gentity_t *ent = &g_entities[i];
+		if ( !ent->inuse || !ent->client || !ent->NPC || ent->playerModel < 0 || !ent->ghoul2.size() ) {
+			continue;
+		}
+		CGhoul2Info &g2 = ent->ghoul2[ent->playerModel];
+		const int bones[2] = { ent->rootBone, ent->lowerLumbarBone };
+		for ( int b = 0; b < 2; b++ ) {
+			if ( bones[b] < 0 || bones[b] >= (int)g2.mBlist.size() ) {
+				continue;
+			}
+			const boneInfo_t &bone = g2.mBlist[bones[b]];
+			Com_Printf( "swjkja npc %d %s %.1f %.1f %.1f anim %d %s start %d end %d time %d speed %.4f flags %d pause %d blend %d %d %.2f\n",
+				i, ent->NPC_type, ent->currentOrigin[0], ent->currentOrigin[1], ent->currentOrigin[2],
+				b ? ent->client->ps.torsoAnim : ent->client->ps.legsAnim, b ? "torso" : "legs",
+				bone.startFrame, bone.endFrame, bone.startTime - first, bone.animSpeed, bone.flags, bone.pauseTime,
+				bone.blendStart - first, bone.blendTime, bone.blendFrame );
+		}
+	}
+}
