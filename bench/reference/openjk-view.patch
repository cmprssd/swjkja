+		Q_swjkjaRandLog( file, line, min, max, result, holdrand );
+	}
+	return result;
+}
+
+int Q_irandAt( int min, int max, const char *file, int line )
+{
+	int result = irand( min, max );
+	if ( Q_swjkjaRandLog ) {
+		Q_swjkjaRandLog( file, line, (float)min, (float)max, (float)result, holdrand );
+	}
+	return result;
+}
