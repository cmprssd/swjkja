+// swjkja benchmark: with cg_swjkjaPath set, every frame's view, game time and a
+// microsecond timestamp are kept in memory and written to that file when the cgame
+// shuts down (CG_SwjkjaWritePath), so logging costs nothing during the run.
+typedef struct {
+	long long usec;
+	int time;
+	vec3_t origin, angles;
+	float fov_x;
+} swjkjaFrame_t;
+#define SWJKJA_MAX_FRAMES 16384
+static swjkjaFrame_t swjkjaFrames[SWJKJA_MAX_FRAMES];
+static int swjkjaFrameCount;
+
+static void CG_SwjkjaLogFrame( void ) {
+	struct timespec ts;
+	swjkjaFrame_t *f;
+	if ( !cg_swjkjaPath.string[0] || swjkjaFrameCount >= SWJKJA_MAX_FRAMES ) {
+		return;
+	}
+	timespec_get( &ts, TIME_UTC );
+	f = &swjkjaFrames[swjkjaFrameCount++];
+	f->usec = (long long)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+	f->time = cg.refdef.time;
+	VectorCopy( cg.refdef.vieworg, f->origin );
+	VectorCopy( cg.refdef.viewangles, f->angles );
+	f->fov_x = cg.refdef.fov_x;
+}
+
+void CG_SwjkjaWritePath( void ) {
+	fileHandle_t fh;
+	char line[256];
+	int i;
+	if ( !cg_swjkjaPath.string[0] || !swjkjaFrameCount ) {
+		return;
+	}
+	trap->FS_Open( cg_swjkjaPath.string, &fh, FS_WRITE );
+	if ( !fh ) {
+		return;
+	}
+	Com_sprintf( line, sizeof( line ), "# usec time_ms x y z pitch yaw roll fov_x\n" );
+	trap->FS_Write( line, strlen( line ), fh );
+	for ( i = 0; i < swjkjaFrameCount; i++ ) {
+		const swjkjaFrame_t *f = &swjkjaFrames[i];
+		Com_sprintf( line, sizeof( line ), "%lld %d %.3f %.3f %.3f %.4f %.4f %.4f %.3f\n", f->usec, f->time,
+			f->origin[0], f->origin[1], f->origin[2], f->angles[0], f->angles[1], f->angles[2], f->fov_x );
+		trap->FS_Write( line, strlen( line ), fh );
+	}
+	trap->FS_Close( fh );
+	trap->Print( "swjkja path: %d frames written to %s\n", swjkjaFrameCount, cg_swjkjaPath.string );
+	swjkjaFrameCount = 0;
+}
